# Application
APP_ENV=development
APP_DEBUG=true
APP_LOG_LEVEL=info
APP_LOG_DIR=logs
APP_LOG_JSON=false
CONTROL_API_TOKEN=dev-control-token

# Cluster identity
CLUSTER_NAME=core-dev-us-east-1a
VM_NAME=core-d-us1a-api-01

# IDs
HASHID_SALT=change-me-in-production
HASHID_LENGTH=11
ULID_LENGTH=22

# Auth tokens (client API key tokens)
TOKEN_API_KEY_DURATION=1h
TOKEN_API_KEY_MAX_DURATION=24h
TOKEN_SIGNING_METHOD=HS256

# HTTP ports
PORT_ADMIN_API=8081
PORT_CONTROL_API=8091
PORT_REST_API=8111
PORT_WEBSOCKET=8131

# CORS
CORS_ADMIN_ORIGINS=*
CORS_CONTROL_ORIGINS=*
CORS_REST_ORIGINS=*
CORS_WEBSOCKET_ORIGINS=*

# Database (compose defaults to Postgres)
DB_DRIVER=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=qpub
DB_USER=qpub
DB_PASSWORD=qpub
DB_SSLMODE=disable
# CockroachDB alternative (outside the default compose stack):
# DB_DRIVER=cockroach
# DB_HOST=cockroach
# DB_PORT=26257
# DB_COCKROACH_RETRIES=3

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# NATS
NATS_URL=nats://localhost:4222

# Queue
QUEUE_DRIVER=jetstream
QUEUE_CONCURRENCY=10
